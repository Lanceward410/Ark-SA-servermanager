<Window x:Class="ArkAutomata.GUI.Views.RconConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RCON Console" 
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Server Info -->
        <Border Grid.Row="0" Background="#34495E" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="ServerNameText" Foreground="White" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="ServerInfoText" Foreground="#ECF0F1" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Command History / Output -->
        <Border Grid.Row="1" BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,0,0,10">
            <ScrollViewer x:Name="OutputScrollViewer" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="OutputTextBox" 
                         IsReadOnly="True" 
                         TextWrapping="Wrap"
                         FontFamily="Consolas" 
                         FontSize="12"
                         Background="#1E1E1E" 
                         Foreground="#D4D4D4"
                         BorderThickness="0"
                         Padding="10"/>
            </ScrollViewer>
        </Border>

        <!-- Command Input -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="CommandTextBox" 
                     Grid.Column="0"
                     Height="30" 
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     KeyDown="CommandTextBox_KeyDown"/>

            <Button Grid.Column="1" 
                    Content="Send" 
                    Click="SendCommand_Click"
                    Width="80" 
                    Height="30" 
                    Margin="10,0,0,0"
                    Background="#27AE60" 
                    Foreground="White"/>
        </Grid>

        <!-- Quick Commands -->
        <GroupBox Grid.Row="3" Header="Quick Commands" Padding="10">
            <WrapPanel>
                <Button Content="List Players" Click="QuickCommand_Click" Tag="listplayers" Margin="0,0,5,5" Padding="10,5"/>
                <Button Content="Save World" Click="QuickCommand_Click" Tag="saveworld" Margin="0,0,5,5" Padding="10,5"/>
                <Button Content="Destroy Wild Dinos" Click="QuickCommand_Click" Tag="destroywilddinos" Margin="0,0,5,5" Padding="10,5"/>
                <Button Content="Broadcast..." Click="QuickBroadcast_Click" Margin="0,0,5,5" Padding="10,5"/>
            </WrapPanel>
        </GroupBox>
    </Grid>
</Window>
